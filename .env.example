# Get the token from @BotFather. Keep it secret.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# One or more numeric Telegram user IDs, comma-separated.
ADMIN_IDS=YOUR_NUMERIC_TELEGRAM_USER_ID

# SQLite database file. Set this to a persistent mounted directory on your host.
DATABASE_PATH=data/sbor.sqlite3

# Optional overrides used only when the database is first initialized.
# COMPANY_NAME=Название компании
# WELCOME_TEXT=Приветствие для клиентов
# CONTACT_TEXT=Как связаться с компанией
